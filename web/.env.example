# Copy to .env.local for development. Each server sets these in its host's settings; see docs/DEPLOYMENT.md.

# Where the website reaches the API, from the web server itself. On live servers this is the API's internal address,
# not its public one, so the visitor's own network address reaches the API (viewing limits, decision 52).
API_BASE_URL="http://localhost:3000/v1"

# The public address of this website, used in links for search engines.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"

# Where signing in, creating an account and everything after it happens: the signed-in web app.
NEXT_PUBLIC_APP_URL="http://localhost:8080"

# Country the website is shown for (ISO code); its currency, switches and settings come from the API.
SITE_COUNTRY="NG"

# Store pages of the phone apps. Leave empty until the apps are published; the links are hidden until then.
NEXT_PUBLIC_PLAY_STORE_URL=""
NEXT_PUBLIC_APP_STORE_URL=""
