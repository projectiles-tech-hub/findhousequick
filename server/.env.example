# Copy this file to .env and adjust for your machine. Never commit .env.

NODE_ENV=development
PORT=3000

# PostgreSQL 16 with PostGIS
DATABASE_URL="postgresql://fhq:fhq_dev_password@localhost:5432/findhousequick?schema=public"

# Redis 7
REDIS_URL="redis://localhost:6379"

# Web addresses allowed to call the API from a browser, comma-separated.
CORS_ORIGINS="http://localhost:8080"

# Secret used to sign login tokens. Use a long random value outside development.
JWT_SECRET="change-me-to-a-long-random-string"

# Secret used to scramble SMS codes before storing them. Must differ from JWT_SECRET.
# Generate with: openssl rand -hex 32
OTP_HASH_SECRET="change-me-to-a-different-long-random-string"

# Secret used to make lookup fingerprints of ID numbers, so one ID used on two accounts can be spotted
# without storing the number readably. Must differ from the secrets above. Never change it once real
# checks exist, or earlier fingerprints stop matching. Generate with: openssl rand -hex 32
LOOKUP_HASH_SECRET="change-me-to-a-third-long-random-string"

# Key used to encrypt sensitive fields (ID numbers, bank account numbers).
# 32 bytes, base64 encoded. Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"

# How long sign-ins last. Access tokens in minutes; signed-in devices in days.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# SMS service for one-time codes. "log" prints codes to the server log (development only).
SMS_PROVIDER="log"

# Email service for codes and notices. "log" prints emails to the server log (development only).
EMAIL_PROVIDER="log"
EMAIL_FROM="FindHouseQuick <no-reply@findhousequick.com>"

# Private storage for identity and ownership documents. "local" keeps files in a folder and serves uploads
# through the API (development only).
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR=".private-storage"

# The API's own address as the apps reach it, used in upload links.
API_PUBLIC_URL="http://localhost:3000"

# The public website's address, used in the invitation links scouts share with landlords.
PUBLIC_WEB_URL="http://localhost:3100"

# Whether this server runs background jobs (needs Redis).
RUN_BACKGROUND_JOBS="true"

# How many proxies (Cloudflare, a web server) stand in front of the API; 0 for none. The viewing limits need the
# visitor's real address (decision 52).
TRUST_PROXY_HOPS="0"

# Push notifications (decision 46): "log" writes them to the server log (development only).
PUSH_PROVIDER="log"
# Voice calls inside the app (decision 44): "test" carries no voice (development only).
CALL_PROVIDER="test"

# Maps (decision 81; docs/adr/0015-maps-providers.md): "none", "google" or "openstreetmap".
MAPS_PROVIDER="none"
# Send one use to a different provider (leave out to follow MAPS_PROVIDER):
# MAPS_PLACES_PROVIDER="openstreetmap"
# MAPS_AMENITIES_PROVIDER="openstreetmap"
# MAPS_TRAVEL_PROVIDER="google"
# Needed when any use is "google" (Places API (New) and Routes API):
# GOOGLE_MAPS_API_KEY=""
# Needed for each use that is "openstreetmap": Nominatim, Overpass and OSRM servers.
# OSM_SEARCH_URL="https://nominatim.example.com"
# OSM_AMENITIES_URL="https://overpass.example.com/api/interpreter"
# OSM_ROUTES_URL="https://osrm.example.com"
# OSM_USER_AGENT="FindHouseQuick (support@findhousequick.com)"
# MAPS_TIMEOUT_MS="4000"
# The map picture in the apps. Follows MAPS_PROVIDER unless set; without its key or address the map shows as not available.
# MAPS_TILES_PROVIDER="openstreetmap"
# A separate Google key for the Map Tiles API only; the apps see it, so restrict it to our app and website.
# GOOGLE_MAPS_TILES_KEY=""
# OSM_TILES_URL="https://tiles.example.com/{z}/{x}/{y}.png"
# OSM_TILES_ATTRIBUTION="© OpenStreetMap contributors"

# Automatic blurring of faces, number plates, documents and family photographs in property photos (Specification 15.3).
# "none" finds nothing; a real provider must be chosen and set before real users sign up.
# PRIVATE_REGIONS_PROVIDER="none"
# The secret behind the hidden watermark in display photos. At least 32 random characters; required in production.
# HIDDEN_MARK_KEY=""
